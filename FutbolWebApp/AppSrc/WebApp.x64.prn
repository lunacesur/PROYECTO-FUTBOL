38302>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38305>>>        Case Begin
38305>>>            Case (NavigateData.eNavigateType = nfFromMain)
38307>>>                // If from main, this is a propbably a main file Select to Zoom.
38307>>>                Case Break
38308>>>
38308>>>            Case (NavigateData.eNavigateType = nfFromParent)
38311>>>                // If from parent, this is a constrained drill down.
38311>>>                Case Break
38312>>>
38312>>>            Case (NavigateData.eNavigateType = nfFromChild)
38315>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38315>>>                Case Break
38316>>>
38316>>>            Case Else // must be nfUndefined
38316>>>
38316>>>        Case End
38316>>>
38316>>>        Send SetActionButtons
38317>>>
38317>>>    End_Procedure
38318>>>
38318>>>End_Object 
