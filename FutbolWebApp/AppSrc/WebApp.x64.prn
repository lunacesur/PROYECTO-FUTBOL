38457>>>            Case (NavigateData.eNavigateType = nfFromChild)
38460>>>                // If from child, this is a probably a parent lookup from a Zoom
38460>>>                Case Break
38461>>>
38461>>>            Case (NavigateData.eNavigateType = nfFromMain)
38464>>>                // If from main, this is a probably a main-file lookup from a Zoom
38464>>>                WebSet pbRender of oDetailButton to False
38465>>>                Case Break
38466>>>
38466>>>            Case Else // must be nfUndefined
38466>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38466>>>                // If Row select does main-zoom we don't need this
38466>>>                WebSet pbRender of oDetailButton to False
38467>>>
38467>>>        Case End
38467>>>
38467>>>    End_Procedure
