38431>>>                // If from child, this is a probably a parent lookup from a Zoom
38431>>>                Case Break
38432>>>
38432>>>            Case (NavigateData.eNavigateType = nfFromMain)
38435>>>                // If from main, this is a probably a main-file lookup from a Zoom
38435>>>                WebSet pbRender of oDetailButton to False
38436>>>                Case Break
38437>>>
38437>>>            Case Else // must be nfUndefined
38437>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38437>>>                // If Row select does main-zoom we don't need this
38437>>>                WebSet pbRender of oDetailButton to False
38438>>>
38438>>>        Case End
38438>>>
