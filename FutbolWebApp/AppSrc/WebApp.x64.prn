37598>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37601>>>        // Close after save
37601>>>        Send NavigateClose Self
37602>>>    End_Procedure
37603>>>
37603>>>    // this will close the view after a delete
37603>>>    Procedure OnViewDeleted Handle hoDDO
