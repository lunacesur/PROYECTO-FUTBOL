37943>>>    Procedure SetActionButtons
37946>>>        tWebNavigateData NavigateData
37946>>>        tWebNavigateData NavigateData
37946>>>        Boolean bHasRecord
37946>>>        Handle hoDD
37946>>>
37946>>>        Get Server to hoDD
37947>>>        Get GetNavigateData to NavigateData
37948>>>        Get HasRecord of hoDD to bHasRecord
37949>>>
37949>>>        // let's hide all buttons and then Show the ones we want
37949>>>        WebSet pbRender of oEditBtn to False
37950>>>        WebSet pbRender of oSaveBtn to False
37951>>>        WebSet pbRender of oCancelChangesBtn to False
37952>>>        WebSet pbRender of oDeleteBtn to False
37953>>>
37953>>>        If (NavigateData.bReadOnly) Begin
37955>>>            WebSet pbRender of oEditBtn to True
37956>>>        End
37956>>>>
37956>>>        Else Begin
37957>>>            WebSet pbRender of oSaveBtn to True
37958>>>            WebSet pbRender of oCancelChangesBtn to True
37959>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37960>>>        End
37960>>>>
37960>>>    End_Procedure
37961>>>
37961>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37964>>>        // Close after save
37964>>>        Send NavigateClose Self
37965>>>    End_Procedure
37966>>>
37966>>>    // this will close the view after a delete
37966>>>    Procedure OnViewDeleted Handle hoDDO
37969>>>        Send NavigateClose Self
37970>>>    End_Procedure
37971>>>
37971>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37974>>>        Case Begin
37974>>>            Case (NavigateData.eNavigateType = nfFromMain)
37976>>>                // If from main, this is a propbably a main file Select to Zoom.
37976>>>                Case Break
37977>>>
37977>>>            Case (NavigateData.eNavigateType = nfFromParent)
37980>>>                // If from parent, this is a constrained drill down.
37980>>>                Case Break
37981>>>
37981>>>            Case (NavigateData.eNavigateType = nfFromChild)
37984>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37984>>>                Case Break
37985>>>
37985>>>            Case Else // must be nfUndefined
37985>>>
37985>>>        Case End
37985>>>
37985>>>        Send SetActionButtons
37986>>>
37986>>>    End_Procedure
37987>>>
37987>>>End_Object 
