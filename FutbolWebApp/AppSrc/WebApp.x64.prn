38274>>>    Procedure SetActionButtons
38277>>>        tWebNavigateData NavigateData
38277>>>        tWebNavigateData NavigateData
38277>>>        Boolean bHasRecord
38277>>>        Handle hoDD
38277>>>
38277>>>        Get Server to hoDD
38278>>>        Get GetNavigateData to NavigateData
38279>>>        Get HasRecord of hoDD to bHasRecord
38280>>>
38280>>>        // let's hide all buttons and then Show the ones we want
38280>>>        WebSet pbRender of oEditBtn to False
38281>>>        WebSet pbRender of oSaveBtn to False
38282>>>        WebSet pbRender of oCancelChangesBtn to False
38283>>>        WebSet pbRender of oDeleteBtn to False
38284>>>
38284>>>        If (NavigateData.bReadOnly) Begin
38286>>>            WebSet pbRender of oEditBtn to True
38287>>>        End
38287>>>>
38287>>>        Else Begin
38288>>>            WebSet pbRender of oSaveBtn to True
38289>>>            WebSet pbRender of oCancelChangesBtn to True
38290>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38291>>>        End
38291>>>>
38291>>>    End_Procedure
