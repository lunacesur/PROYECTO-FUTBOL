37762>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37765>>>        WebSet pbRender of oNewButton to True
37766>>>        WebSet pbRender of oDetailButton to True
37767>>>
37767>>>        Case Begin
37767>>>            Case (NavigateData.eNavigateType = nfFromParent)
37769>>>                // If from parent, this is a constrained drill down
37769>>>                // If Row select does main-zoom we don't need this
37769>>>                WebSet pbRender of oDetailButton to False
37770>>>                Case Break
37771>>>
37771>>>            Case (NavigateData.eNavigateType = nfFromChild)
37774>>>                // If from child, this is a probably a parent lookup from a Zoom
37774>>>                Case Break
37775>>>
37775>>>            Case (NavigateData.eNavigateType = nfFromMain)
37778>>>                // If from main, this is a probably a main-file lookup from a Zoom
37778>>>                WebSet pbRender of oDetailButton to False
37779>>>                Case Break
37780>>>
37780>>>            Case Else // must be nfUndefined
37780>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37780>>>                // If Row select does main-zoom we don't need this
37780>>>                WebSet pbRender of oDetailButton to False
37781>>>
37781>>>        Case End
37781>>>
37781>>>    End_Procedure
37782>>>
